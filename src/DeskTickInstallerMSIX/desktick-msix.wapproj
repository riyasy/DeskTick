<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>3f2b90d4-6c81-4a55-9b3e-27ac5f18e604</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <!-- 1809, the same floor Package.appxmanifest declares. -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Unsigned: the Store re-signs on upload. Sideloading a build from here
         needs a certificate of your own — or a Debug build, which the temporary
         store certificate covers. -->
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <AppxBundle>Always</AppxBundle>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <EntryPointProjectUniqueName>..\DeskTick\DeskTick.vcxproj</EntryPointProjectUniqueName>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <!-- The tile art, as a glob rather than fifty-one lines: what is in the
       folder is what ships, so dropping a new set in is a file copy and never
       a project edit. -->
  <ItemGroup>
    <Content Include="Images\*.png" />
    <None Include="Package.StoreAssociation.xml" />
  </ItemGroup>
  <!-- The translations and the image faces. DesktopBridge packages the
       referenced project's build *outputs*, not everything sitting in its output
       folder, and neither of these folders is a build output — the loose exe
       finds them by walking up from itself (FindNearExe). So they have to be
       named here, and the Link is what puts them beside the exe inside the
       package's DeskTick\ folder, where that same walk finds them first.
       Without this the MSIX ships English-only and with no image faces. -->
  <ItemGroup>
    <Content Include="..\DeskTick\lang\*.ini">
      <Link>DeskTick\lang\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\DeskTick\assets\*.png">
      <Link>DeskTick\assets\%(Filename)%(Extension)</Link>
    </Content>
    <!-- DeskTick's own terms, from the repo root, so the package carries what
         the release zip carries. GPLv3 section 4 asks that a copy of the licence
         travel with the program. -->
    <Content Include="..\..\LICENSE">
      <Link>DeskTick\LICENSE</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <ItemGroup>
    <ProjectReference Include="..\DeskTick\DeskTick.vcxproj" />
  </ItemGroup>
</Project>
